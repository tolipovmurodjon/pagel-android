<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The anchor foreground service + the gateway WebSocket. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Phase D Task 5: location.get — a fix obtainable while the app is closed and the phone is
         locked. ACCESS_BACKGROUND_LOCATION is the whole point: the Play-Store build of the official
         OpenClaw app never declares it, so Android never offers "Allow all the time" for it at all —
         a manifest ceiling no setting can work around. Declaring it here is what makes that option
         exist; Boss still has to grant it himself in Settings (no runtime dialog can, Android 11+). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".PagelApp"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="PAGEL"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pagel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Anchor foreground service: holds the process (and therefore both gateway connections)
             alive, and (Phase D Task 5) is where a backgrounded location.get fix gets obtained. The
             manifest attribute is the *ceiling*; a startForeground() call may pass any subset of it,
             so declaring both bits here is safe even before Boss has granted location — see
             AnchorService.foregroundServiceType() for the runtime subset choice. specialUse and
             location are not documented as mutually exclusive (unlike shortService, which the
             platform explicitly demotes when combined with another type), so both are kept:
             specialUse is what keeps this catch-all anchor service alive and must never be silently
             dropped, and location is what lets a fix be obtained while backgrounded. -->
        <service
            android:name=".service.AnchorService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous owner life-logging for a personal AI assistant" />
        </service>
    </application>
</manifest>
