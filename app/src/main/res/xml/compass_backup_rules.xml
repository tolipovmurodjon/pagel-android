<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (minSdk 30): the same exclusion for the old backup path. -->
<full-backup-content>
    <exclude domain="database" path="compass.db" />
    <exclude domain="database" path="compass.db-wal" />
    <exclude domain="database" path="compass.db-shm" />
    <!-- The locked journal (Phase 6b): sealed the same way, its key never moves either. -->
    <exclude domain="database" path="journal.db" />
    <exclude domain="database" path="journal.db-wal" />
    <exclude domain="database" path="journal.db-shm" />
</full-backup-content>
